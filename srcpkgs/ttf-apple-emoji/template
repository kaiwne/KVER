# Template file for 'ttf-apple-emoji'

# -----------------------------------

pkgname=ttf-apple-emoji
version=1.0.0
revision=1
short_desc="Apple Color Emoji is a color typeface used by iOS and macOS to display emoji"
maintainer="Kaiwne <kaiwne@proton.me>"
license="MIT"
homepage="https://github.com/samuelngs/apple-emoji-ttf"
changelog="https://github.com/samuelngs/apple-emoji-ttf/releases"

# -----------------------------------

hostmakedepends="curl"
depends="font-util"
font_dirs="/usr/share/fonts/TTF/apple-color-emoji"
provides="font:emoji-0_1"

# -----------------------------------

do_install() {
	curl -L https://github.com/samuelngs/apple-emoji-ttf/releases/latest/download/AppleColorEmoji-Linux.ttf -O
	vinstall "AppleColorEmoji-Linux.ttf" 644 ${font_dirs}
}
