post_extract() {
        vsrcextract -C "third_party/dynarmic" "${_dynarmic_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/biscuit" "${_dynarmic_biscuit_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/catch" "${_dynarmic_catch2_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/fmt" "${_dynarmic_fmt_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/mcl" "${_dynarmic_mcl_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/oaknut" "${_dynarmic_oaknut_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/robin-map" "${_dynarmic_robin_map_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/xbyak" "${_dynarmic_xbyak_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/zycore" "${_dynarmic_zycore_c_version}.tar.gz"
        vsrcextract -C "third_party/dynarmic/externals/zydis" "${_dynarmic_zydis_version}.tar.gz"
        vsrcextract -C "third_party/libjnivm" "${_libjnivm_version}.tar.gz"
        vsrcextract -C "third_party/mcpelauncher-linker" "${_mcpelauncher_linker_version}.tar.gz"
        vsrcextract -C "third_party/mcpelauncher-linker/bionic" "${_mcpell_bionic_version}.tar.gz"
        vsrcextract -C "third_party/mcpelauncher-linker/core" "${_mcpell_core_version}.tar.gz"
}

do_build() {
	export CC=clang CXX=clang++
	cargo build --release
}

do_install() {
	vbin "target/release/cordial-shell"
	vbin "target/release/cordial-run"
	ln -sf "cordial-shell" "${DESTDIR}/usr/bin/cordial"

	vmkdir "usr/share/cordial/plugins"
	vmkdir "usr/share/applications"
	vmkdir "usr/share/icons/hicolor/scalable/apps"
	vcopy "plugins/*" "usr/share/cordial/plugins/"
	vcopy "packaging/io.github.luohoa97.Cordial.desktop" "usr/share/applications"
	vcopy "packaging/io.github.luohoa97.Cordial.metainfo.xml" "usr/share/applications"
	vcopy "packaging/icons/hicolor/scalable/apps/*" "usr/share/icons/hicolor/scalable/apps/"
	vlicense LICENSE
	vlicense NOTICE
	vlicense THIRD-PARTY-NOTICES.md
	vlicense third_party/dynarmic/LICENSE.txt dynarmic-0BSD.txt
	vlicense third_party/dynarmic/externals/fmt/LICENSE fmt-MIT.txt
	vlicense third_party/dynarmic/externals/mcl/LICENSE mcl-MIT.txt
	vlicense third_party/dynarmic/externals/xbyak/COPYRIGHT xbyak-BSD-3-Clause.txt
	vlicense third_party/dynarmic/externals/zydis/LICENSE zydis-MIT.txt
	vlicense third_party/dynarmic/externals/zycore/LICENSE zycore-MIT.txt
	vlicense third_party/libbadcpu/LICENSE.upstream libbadcpu-MIT.txt
	vlicense third_party/libjnivm/LICENSE libjnivm-MIT.txt
	vlicense third_party/mcpelauncher-linker/LICENSE mcpelauncher-linker-MIT.txt
	vlicense third_party/mcpelauncher-linker/core/NOTICE aosp-NOTICE.txt
	vlicense third_party/mocktail-webview/LICENSE mocktail-webview-Apache-2.0.tx
}
